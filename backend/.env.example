# ==============================================================================
# ProctorAI Backend Environment Configuration
# Copy this file to .env and configure the values for your environment:
# cp .env.example .env
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Connection
# MongoDB Atlas connection string or local MongoDB instance
# Example: mongodb://127.0.0.1:27017/examproctor
MONGODB_URI=mongodb://127.0.0.1:27017/examproctor

# Authentication & Security
# Secret used to sign JSON Web Tokens (use a strong random string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Frontend Client URL (used in email notification links)
FRONTEND_URL=http://localhost:5173

# Institution & Portal Settings
# Restrict registration to a specific email domain (e.g., @mite.ac.in or @college.edu).
# Set to * to allow all email domains.
ALLOWED_EMAIL_DOMAIN=@mite.ac.in
PORTAL_NAME=MITE Exam Portal

# SMTP / Email Service Configuration (Optional)
# If SMTP_HOST is omitted, backend automatically provisions an Ethereal test account
# and prints preview URLs to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=ProctorAI Exam Cell
FROM_EMAIL=noreply@proctorai.com
